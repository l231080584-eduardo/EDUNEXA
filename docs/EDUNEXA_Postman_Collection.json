        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Gabriel Briseño\",\n  \"email\": \"gabriel.test@edunexa.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/usuarios/registro"
      }
    },
