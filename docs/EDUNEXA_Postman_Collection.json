{
  "info": {
    "_postman_id": "edunexa-api-collection-v1",
    "name": "EDUNEXA API - Pruebas de controladores",
    "description": "Pruebas de HealthController y UsuarioController sobre la API v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://edunexa-backend:8080"
    }
  ],
  "item": [
    {
      "name": "1. Health - API disponible (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El estado HTTP es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('La respuesta es JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    pm.expect(pm.response.json()).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Registrar usuario válido (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario QA\",\n  \"email\": \"qa+{{$guid}}@edunexa.test\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/usuarios/registro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El estado HTTP es 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('La respuesta es JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    pm.expect(pm.response.json()).to.be.an('object');",
              "});",
              "",
              "pm.test('El tiempo de respuesta es menor a 500 ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Usuario inexistente (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/usuarios/00000000-0000-0000-0000-000000000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El estado HTTP es 404 o 400', function () {",
              "    pm.expect([400, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
